# Copier en .env.local et remplir. Ne jamais committer de vraie valeur.
# Les variables NEXT_PUBLIC_* finissent dans le navigateur : rien de secret.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # secret, serveur uniquement

# Site
NEXT_PUBLIC_SITE_URL=https://www.codedeparrainage.com
ADMIN_EMAIL=                          # seul compte autorisé sur /admin

# Stripe
STRIPE_SECRET_KEY=                    # secret
STRIPE_WEBHOOK_SECRET=                # secret (signature des webhooks)

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=                 # secret

# Resend (e-mails)
RESEND_API_KEY=                       # secret
RESEND_FROM_EMAIL=noreply@codedeparrainage.com
